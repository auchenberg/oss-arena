{
  "expo": {
    "name": "Kubera Widgets",
    "slug": "kubera-widgets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kuberawidgets",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.auchenberg.kuberawidgets",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.auchenberg.kuberawidgets"],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.auchenberg.kuberawidgets.shared"
        ]
      }
    },
    "android": {
      "package": "com.auchenberg.kuberawidgets",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
